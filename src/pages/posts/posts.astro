---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { isPostListed } from '../../../plugins/post-visibility.mjs';

const posts = (await getCollection('posts', ({ data }) =>
  isPostListed(data.status, import.meta.env.PROD)
))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Base banner="Posts" description="Posts by Anish Rajeev.">
  <nav class="post-index" aria-label="All posts">
    <ul>
      {posts.map((post) => (
        <li>
          <a href={`/posts/${post.id}.html`}>{post.data.title}</a>
          {post.data.status === 'draft' && <small class="draft-label">(draft)</small>}
          {post.data.status === 'unlisted' && <small class="draft-label">(unlisted)</small>}
        </li>
      ))}
    </ul>
  </nav>
</Base>
